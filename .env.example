# ── Pulse Environment Config ──────────────────────────────────
# Copy this to .env and fill in your values.

APP_NAME=Pulse
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database (SQLite works out of the box)
DB_DRIVER=sqlite
DB_DATABASE=storage/pulse.db

# Optional: MySQL
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_DATABASE=pulse
# DB_USERNAME=root
# DB_PASSWORD=

# Your info
AUTHOR_NAME=Your Name
AUTHOR_ROLE=Full-Stack Developer
GITHUB_URL=https://github.com/yourhandle